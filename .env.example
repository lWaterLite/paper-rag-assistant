# paper-rag-assistant 子模块 1 配置示例

# 每个 chunk 的目标字符长度，必须大于 0。
RAG_CHUNK_SIZE=500

# 相邻 chunk 的重叠字符数，必须大于等于 0，并且小于 RAG_CHUNK_SIZE。
RAG_CHUNK_OVERLAP=80

# 检索阶段返回的候选 chunk 数量，必须大于 0。
RAG_TOP_K=3

# 进入生成阶段的最大上下文字符数，必须大于 0。
RAG_MAX_CONTEXT_CHARS=1800

# 兼容旧练习入口的 mock embedding 维度。
# 子模块 4 起，实际索引构建优先读取 settings.toml 中的 [embedding].dimension。
RAG_MOCK_EMBEDDING_DIMENSION=16

# 是否要求回答包含引用。
RAG_REQUIRE_CITATION=true

# 检索策略，必须为 vector、bm25、hybrid 其中之一。
RAG_RETRIEVAL_STRATEGY=vector

# 兼容旧练习入口的索引持久化目录。
# 子模块 4 起，实际索引构建优先读取 settings.toml 中的 [vector_store].index_dir。
RAG_INDEX_STORAGE_PATH=data/indexes

# 是否在响应中返回完整 trace。
RAG_DEBUG_TRACE=false

# loader、PDF cleaner、chunking、embedding、vector store、indexing 等结构化工程配置已经迁移到 settings.toml。

# 如果 settings.toml 中 [embedding].provider = "openai"，
# 请在真实运行环境中设置 [embedding].api_key_env_name 指向的变量。
# 示例：
# OPENAI_API_KEY=replace-with-your-real-key
