# paper-rag-assistant 子模块 1 配置示例

# 每个 chunk 的目标字符长度，必须大于 0。
RAG_CHUNK_SIZE=500

# 相邻 chunk 的重叠字符数，必须大于等于 0，并且小于 RAG_CHUNK_SIZE。
RAG_CHUNK_OVERLAP=80

# 检索阶段返回的候选 chunk 数量，必须大于 0。
RAG_TOP_K=3

# 进入生成阶段的最大上下文字符数，必须大于 0。
RAG_MAX_CONTEXT_CHARS=1800

# mock embedding 的向量维度，必须大于 0。
RAG_MOCK_EMBEDDING_DIMENSION=16

# 是否要求回答包含引用。
RAG_REQUIRE_CITATION=true

